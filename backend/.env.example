# ==============================================================================
#  SpeakFlow AI — environment configuration
#
#  HOW TO SET UP (one time):
#    1. Copy this file and rename the copy to:  .env   (must sit in backend/)
#       In Command Prompt:  copy .env.example .env
#    2. Fill in the optional provider keys below — where to get each one is written
#       next to it. Check provider availability and terms before use.
#    3. Save, then start the app with start_speakflow.bat
#
#  NEVER commit your real .env — it is gitignored on purpose.
# ==============================================================================

# ── META AI ECOSYSTEM & OPEN WEIGHTS PROVIDER ─────────────────────────────────

# Meta AI LLM endpoint — defaults to https://api.meta.ai/v1 (US judges)
# For Pakistan Geographic Use Policy compliance, configure local Muse Glimmer,
# Baseten, Modal, or Fireworks endpoint URL here:
SPEAKFLOW_LLM_BASE_URL=https://api.meta.ai/v1
REASONING_PROVIDER=meta
REASONING_MODEL=muse-spark-1.3
META_API_KEY=

# Meta Voice Transcribe / Online Speech-to-Text
META_STT_URL=https://api.meta.ai/v1/asr/transcribe
META_STT_MODEL=muse-voice-transcribe-1.0

# ── OPTIONAL — sensible defaults apply if you leave these ────────────────────
ENV=dev

# STT engine choice:
#   auto  = Meta Voice Transcribe when online + key present, local faster-whisper otherwise (recommended)
#   local = always run offline local faster-whisper
STT_MODE=auto

# Local Whisper model for offline speech-to-text (base = recommended, tiny = fastest)
WHISPER_MODEL=base

# Cloud sync ingest endpoint for offline sessions (leave empty to disable)
CLOUD_SYNC_URL=

# Extra tuning (defaults in core/config.py)
# STT_TIMEOUT_S=3
# WORD_CORRECT_THRESHOLD=70
# CHECKPOINT_PASS_THRESHOLD=70

# Explicit offline mode disables cloud reasoning, online STT and sync.
# Cache local speech weights before enabling it.
OFFLINE_MODE=0
ENABLE_MOCK_ANALYSIS=0
USE_REFERENCE_VECTORS=0
JUDGE_HESITATION_ENABLED=0
# Additional frontend origins, comma-separated; use HTTPS in production.
ALLOWED_ORIGINS=
# Dedicated secret shared only by the sync sender and archive receiver (32+ chars).
SYNC_SHARED_SECRET=
HOST=127.0.0.1
PORT=8000
RELOAD=0
# Optional ffmpeg directory; otherwise system PATH/bundled executable is used.
FFMPEG_DIR=

# Enable only with the completed onboarding UI; account/profile API is ready.
ENFORCE_PROFILE_COMPLETION=0

# Reasoning selection only; does not change STT, TTS, language gates or scoring.
# google (default) | chat_completions | meta. No automatic provider failover.
REASONING_PROVIDER=google
# Explicit operator gate for non-Google routes, after access/privacy review.
# This declaration is NOT permission, a region detector or a policy exception.
REASONING_ACCESS_CONFIRMED=0
REASONING_API_KEY=
REASONING_MODEL=
# chat_completions only. Include /v1 if the service uses it; HTTPS required
# except loopback HTTP for a separately installed local server. No redirects.
REASONING_BASE_URL=
# meta uses fixed https://api.meta.ai/v1; model is explicitly configured.
# Hosted Meta access from/serving Pakistan is restricted. Do not enable here.
# See analysis/soven/16_REASONING_PROVIDER_INTEGRATION.md before configuration.
