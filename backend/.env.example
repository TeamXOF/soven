# ==============================================================================
#  SpeakFlow AI — environment configuration
#
#  HOW TO SET UP (one time):
#    1. Copy this file and rename the copy to:  .env   (must sit in backend/)
#       In Command Prompt:  copy .env.example .env
#    2. Fill in the optional provider keys below — where to get each one is written
#       next to it. Check provider availability and terms before use.
#    3. Save, then start the app with start_speakflow.bat
#
#  NEVER commit your real .env — it is gitignored on purpose.
# ==============================================================================

# ── PROVIDERS ──────────────────────────────────────────────────────────────────

# Google AI Studio key(s) — powers the Gemini agents, coaching and practice.
# Get a FREE key at: https://aistudio.google.com/apikey
# Paste it after the "=" (the first configured key is used per request).
GOOGLE_API_KEYS=

# Groq key — fast online speech-to-text (Whisper large-v3).
# Get a FREE key at: https://console.groq.com/keys
GROQ_API_KEY=

# ── OPTIONAL — sensible defaults apply if you leave these ────────────────────

# Dedicated demo-day key (used when ENV=demo so dev traffic never eats quota)
GEMINI_API_KEY_DEMO=
ENV=dev

# STT engine choice (also changeable live on the Settings page):
#   auto  = Groq when online + key present, local Whisper otherwise (recommended)
#   groq  = prefer Groq cloud, graceful local fallback when offline
#   local = never call Groq
STT_MODE=auto

# Classic-engine diagnosis agents (also changeable live on the Settings page):
#   auto = Gemini 3.5 Flash-Lite (fast, recommended)
#   gemini-3.5-flash-lite | gemma-4-31b-it
GEN1_AGENT_MODEL=auto

# Local Whisper model for offline speech-to-text (tiny = fastest, base = better)
WHISPER_MODEL=base

# Cloud sync ingest endpoint for offline sessions (leave empty to disable)
CLOUD_SYNC_URL=

# Extra tuning (defaults in core/config.py)
# STT_TIMEOUT_S=3
# WORD_CORRECT_THRESHOLD=70
# CHECKPOINT_PASS_THRESHOLD=70

# Explicit offline mode disables cloud reasoning, online STT and sync.
# Cache local speech weights before enabling it.
OFFLINE_MODE=0
ENABLE_MOCK_ANALYSIS=0
USE_REFERENCE_VECTORS=0
JUDGE_HESITATION_ENABLED=0
# Additional frontend origins, comma-separated; use HTTPS in production.
ALLOWED_ORIGINS=
# Dedicated secret shared only by the sync sender and archive receiver (32+ chars).
SYNC_SHARED_SECRET=
HOST=127.0.0.1
PORT=8000
RELOAD=0
# Optional ffmpeg directory; otherwise system PATH/bundled executable is used.
FFMPEG_DIR=
